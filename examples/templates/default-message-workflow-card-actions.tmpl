{{ define "teams.card" }}

{{/* Should the potential actions field be included? */}}
{{ $should_have_potential_actions := true }}

{{/* For example 'https://www.google.com/alertkarma/?'. Ignored if empty. */}}
{{ $alertkarma_prefix := ""}}

{{- $cardHeadingLineColor := "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAAECAAAAABqswrmAAAAEElEQVR42mJogEBAAAAA//8ICAIBsBUbsAAAAABJRU5ErkJggg==" }}
{{- /* Heading colour: "=" assigns the variable declared here; ":=" inside
       the if blocks would declare a new one that dies with the block, which
       left the heading colour always empty. "Default" when nothing matches.
       Severity labels are lower case ("warning", not "Warning"). */ -}}
{{- $headingColor := "Default" }}
{{- if eq .Status "resolved" -}}
  {{- $cardHeadingLineColor = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAAECAIAAADAusJtAAAAEklEQVR42mLQPa6LjAEBAAD//yQwBIUSNPBIAAAAAElFTkSuQmCC" -}}
  {{- $headingColor = "Good" }}
{{- else if eq .Status "firing" -}}
  {{- if eq .CommonLabels.severity "critical" -}}
  {{- $cardHeadingLineColor = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAAECAIAAADAusJtAAAAEklEQVR42mLokZJCxoAAAAD//xnYAwEPSWrRAAAAAElFTkSuQmCC" }}
  {{- $headingColor = "Attention" }}
  {{- else if eq .CommonLabels.severity "warning" -}}
  {{- $cardHeadingLineColor = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAAECAIAAADAusJtAAAAEklEQVR42mL4v5QBGQMCAAD//ziMBpHr7M3UAAAAAElFTkSuQmCC" }}
  {{- $headingColor = "Warning" }}
  {{- end -}}
{{- end -}}
{{- /* The line under the heading: the summary annotation, else the message
       annotation, else the alert name. */ -}}
{{- $subtitle := "Prometheus Alert" }}
{{- if .CommonAnnotations.summary }}{{ $subtitle = .CommonAnnotations.summary }}
{{- else if .CommonAnnotations.message }}{{ $subtitle = .CommonAnnotations.message }}
{{- else if .CommonLabels.alertname }}{{ $subtitle = .CommonLabels.alertname }}
{{- end }}
{{- /* Escaping, everywhere a label or annotation value is written:
       mdEscape keeps "_", "*", "[" and "]" from being read as markdown,
       toJson writes the value as a JSON string, quotes included, so that
       quotes and line breaks in it cannot break the card. Links get toJson
       only, and urlquery for a value inside a URL. */}}
{
  "type":"message",
  "attachments":[
  {
      "contentType":"application/vnd.microsoft.card.adaptive",
      "contentUrl":null,
      "content":{
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "type": "AdaptiveCard",
        "version": "1.2",
        "backgroundImage": {
            "url": "{{- $cardHeadingLineColor -}}",
            "fillMode": "RepeatHorizontally"
        },
        "msteams": {
            "width": "Full"
        },
        "body": [
            {
              "type": "TextBlock",
              "text": "Prometheus Alert ({{ .Status | title }})",
              "weight": "bolder",
              "size": "medium",
              "style": "heading",
              "color": "{{- $headingColor -}}"
            },
            {
              "type": "TextBlock",
              "text": {{ $subtitle | mdEscape | toJson }},
              "wrap": true
            },
            {{$externalUrl := .ExternalURL}}
            {{- range $index, $alert := .Alerts }}{{- if $index }},{{- end }}
            {
              "type": "TextBlock",
              "text": {{ printf "[%s](%s)" ($alert.Annotations.description | mdEscape) $externalUrl | toJson }},
              "wrap": true
            },
            {
              "type": "FactSet",
              "facts": [
                {{- /* One fact per annotation except "description" (shown
                       above). The whole fact, braces included, is inside the
                       if; before, "description" produced an empty {}. */ -}}
                {{- range $key, $value := $alert.Annotations }}
                {{- if ne $key "description" }}
                {
                    "title": {{ $key | mdEscape | toJson }},
                    "value": {{ $value | mdEscape | toJson }}
                },
                {{- end -}}
                {{- end -}}
                {{$c := counter}}{{ range $key, $value := $alert.Labels }}{{if call $c}},{{ end }}
                {
                  "title": {{ $key | mdEscape | toJson }},
                  "value": {{ $value | mdEscape | toJson }}
                }
                {{- end }}
              ]
            }
          {{- end }}
          {{- /* Alerts of the group not in the card: left out to keep the
                 card within Teams' size limit, or cut by Alertmanager's
                 webhook max_alerts. */}}
          {{- if .TruncatedAlerts }},
            {
              "type": "TextBlock",
              "text": {{ printf "%d more alerts not shown. [Open the group in Alertmanager](%s/#/alerts?silenced=true&inhibited=true&active=true&filter=%s)" .TruncatedAlerts .ExternalURL (labelMatchers .CommonLabels | urlquery) | toJson }},
              "wrap": true,
              "isSubtle": true
            }
          {{- end }}
        ]
        {{ if $should_have_potential_actions }}
        ,
        "actions": [
          {{- /* Alertmanager's alert list, filtered to the group's common
                 labels: labelMatchers writes {name="value", ...}, urlquery
                 encodes it for the URL. Silenced and inhibited alerts are
                 shown too. */}}
          {
              "type": "Action.OpenUrl",
              "title": "View in Alertmanager",
              "url": {{ printf "%s/#/alerts?silenced=true&inhibited=true&active=true&filter=%s" .ExternalURL (labelMatchers .CommonLabels | urlquery) | toJson }}
          }
        {{ if gt (len $alertkarma_prefix) 0 }}
          ,
          {
            "type": "Action.OpenUrl",
            "title": "View in Alertkarma",
            "url": {{ printf "%sq=alertname%%3D%s" $alertkarma_prefix (.CommonLabels.alertname | urlquery) | toJson }}
          }
        {{ end }}
        {{ if gt (len .CommonAnnotations.investigate_link) 0 }}
          ,
          {
            "type": "Action.OpenUrl",
            "title": "Investigate",
            "url": {{ .CommonAnnotations.investigate_link | trim | toJson }}
          }
        {{ end }}
        {{- if .CommonAnnotations.runbook -}}
          ,
          {
              "type": "Action.OpenUrl",
              "title": "runbook",
              "url": {{ .CommonAnnotations.runbook | toJson }}
          }
        {{- end -}}
        ]
        {{- end -}}
      }
  }]
}
{{ end }}
